{
  "name": "change-proof",
  "version": "0.1.0-beta.1",
  "description": "Reproducible evidence that changed tests distinguish base and head behavior.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puffynNeroun/change-proof.git"
  },
  "homepage": "https://github.com/puffynNeroun/change-proof#readme",
  "bugs": {
    "url": "https://github.com/puffynNeroun/change-proof/issues"
  },
  "keywords": [
    "testing",
    "regression-testing",
    "developer-tools",
    "cli",
    "git"
  ],
  "type": "module",
  "private": true,
  "bin": {
    "change-proof": "bin/change-proof.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "change-proof.config.example.json"
  ],
  "scripts": {
    "test": "node --test --test-reporter=tap test/core/*.test.mjs test/cli/*.test.mjs test/integration/*.test.mjs",
    "test:core": "node --test --test-reporter=tap test/core/*.test.mjs",
    "test:cli": "node --test --test-reporter=tap test/cli/*.test.mjs",
    "test:integration": "node --test --test-reporter=tap test/integration/*.test.mjs"
  }
}
